{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alamaula Listing Output",
  "type": "array",
  "description": "Array of classified listings from Alamaula.com.ar",
  "items": {
    "type": "object",
    "properties": {
      "title": {"type": "string"},
      "price": {"type": ["string", "null"]},
      "priceCurrency": {"type": ["string", "null"]},
      "category": {"type": ["string", "null"]},
      "condition": {"type": ["string", "null"]},
      "location": {"type": ["string", "null"]},
      "description": {"type": ["string", "null"]},
      "url": {"type": "string"},
      "images": {"type": "array", "items": {"type": "string"}},
      "sellerType": {"type": ["string", "null"]},
      "sellerName": {"type": ["string", "null"]},
      "sellerPhone": {"type": ["string", "null"]},
      "postedDate": {"type": ["string", "null"]},
      "photoCount": {"type": ["integer", "null"]},
      "scrapedAt": {"type": "string"}
    },
    "required": ["title", "url", "scrapedAt"]
  }
}
