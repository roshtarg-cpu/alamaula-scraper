{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alamaula Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "title": "Search Query",
      "type": "string",
      "description": "Keywords to search for (e.g., 'volkswagen', 'apartment', 'iphone')",
      "editor": "textfield",
      "prefill": "volkswagen"
    },
    "category": {
      "title": "Category",
      "type": "string",
      "description": "Product category to filter by",
      "editor": "select",
      "enum": ["all", "real-estate", "vehicles", "services", "jobs"],
      "enumTitles": ["All Categories", "Real Estate", "Vehicles", "Services", "Jobs"],
      "default": "all",
      "prefill": "vehicles"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "City or region to search in (e.g., 'Buenos Aires', 'Córdoba')",
      "editor": "textfield",
      "prefill": "Buenos Aires"
    },
    "priceMin": {
      "title": "Minimum Price (ARS)",
      "type": "integer",
      "description": "Minimum price filter in Argentine Pesos",
      "editor": "number",
      "default": 0,
      "prefill": 0
    },
    "priceMax": {
      "title": "Maximum Price (ARS)",
      "type": "integer",
      "description": "Maximum price filter in Argentine Pesos",
      "editor": "number",
      "default": 50000000,
      "prefill": 50000000
    },
    "condition": {
      "title": "Condition",
      "type": "string",
      "description": "Item condition filter",
      "editor": "select",
      "enum": ["all", "new", "used"],
      "enumTitles": ["All Conditions", "New", "Used"],
      "default": "all",
      "prefill": "all"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of listings to scrape",
      "editor": "number",
      "default": 50,
      "minimum": 1,
      "maximum": 500,
      "prefill": 10
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings (optional)",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      }
    }
  },
  "required": ["searchQuery"]
}
