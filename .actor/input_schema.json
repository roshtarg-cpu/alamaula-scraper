{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alamaula Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrls": {
      "title": "Start URLs",
      "type": "array",
      "description": "List of Alamaula.com.ar URLs to scrape (homepage, category pages, search results)",
      "editor": "requestListSources",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "URL",
            "pattern": "^https://.*alamaula\\.com\\.ar.*"
          }
        }
      },
      "prefill": [
        {"url": "https://www.alamaula.com.ar/"}
      ]
    },
    "maxItems": {
      "title": "Max Items",
      "type": "integer",
      "description": "Maximum number of items to scrape. Set to 0 for unlimited.",
      "default": 100,
      "minimum": 0,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper. Residential proxies recommended.",
      "editor": "proxy",
      "default": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    },
    "maxConcurrency": {
      "title": "Max Concurrency",
      "type": "integer",
      "description": "Maximum number of concurrent requests",
      "default": 5,
      "minimum": 1,
      "maximum": 20,
      "editor": "number"
    }
  },
  "required": ["startUrls"]
}
